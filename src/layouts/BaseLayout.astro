---
import AdminPanel from '../components/AdminPanel.astro';
import data from '../../public/data.json';
const { general, links } = data;
const {
  title = "BharCode — Product Engineer · CS Student · Singapore",
  description = "CS student in Singapore building AI-powered products end-to-end. Follow the build log for real technical decisions, project deep-dives, and what it takes to ship.",
  ogImage = "https://bharcode.com/assets/logo.png",
  ogUrl = "https://bharcode.com/"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="alternate" type="application/rss+xml" title="Bharcode RSS Feed" href="/rss.xml">
<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="512x512" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">
<link rel="icon" type="image/webp" sizes="64x64" href="/assets/favicon-64.webp">
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<!-- FIX: Theme must be applied before paint to avoid flash of wrong theme -->
<script is:inline>
  (function() {
    const savedTheme = localStorage.getItem('bharcode-theme');
    const sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'dark' || (!savedTheme && sysDark)) {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Instrument+Serif:ital@0;1&family=Syne+Mono&display=swap" rel="stylesheet">

<style is:global>
  /* ═══════════════════════════════════════════════════
     BHARCODE V2 — REDESIGNED GLOBAL CSS
     ═══════════════════════════════════════════════════ */
  :root {
    /* Palette */
    --ink:        #0D0D0D;
    --paper:      #FAF9F5;
    --paper-alt:  #F2F0E8;
    --accent:     #1A3056;
    --accent2:    #2B5BA8;
    --gold:       #C8A84B;
    --gold-light: rgba(200,168,75,.12);
    --border:     rgba(13,13,13,.12);
    --border-str: rgba(13,13,13,.25);
    --card-bg:    #FFFFFF;
    --nav-bg:     rgba(250,249,245,.88);
    --text:       #0D0D0D;
    --text2:      #444;
    --text3:      #888;
    --tag-bg:     rgba(26,48,86,.07);

    /* Fonts */
    --font-head:  'Instrument Serif', 'Georgia', serif;
    --font-body:  'DM Sans', sans-serif;
    --font-mono:  'Syne Mono', monospace;

    /* Easing */
    --spring:     cubic-bezier(.34,1.4,.64,1);
    --ease-out:   cubic-bezier(.16,1,.3,1);

    /* Grid */
    --max:        1120px;
    --nav-h:      60px;
  }

  [data-theme="dark"] {
    --ink:        #F5F3EE;
    --paper:      #141210;
    --paper-alt:  #1A1A1A;
    --accent:     #7AABFF;
    --accent2:    #5A8EE0;
    --gold:       #D4AA55;
    --gold-light: rgba(212,170,85,.12);
    --border:     rgba(245,243,238,.1);
    --border-str: rgba(245,243,238,.22);
    --card-bg:    #181818;
    --nav-bg:     rgba(17,17,17,.9);
    --text:       #F5F3EE;
    --text2:      #B8B5AE;
    --text3:      #666;
    --tag-bg:     rgba(122,171,255,.1);
  }

  /* ── RESET ──────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }

  body {
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.65;
    cursor: crosshair;
    transition: background .4s var(--ease-out), color .4s var(--ease-out);
  }

  /* ── NOISE GRAIN OVERLAY ─────────────────────────── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.025'/%3E%3C/svg%3E");
    background-size: 256px;
    pointer-events: none;
    z-index: 1;
    opacity: .5;
  }

  /* ── CUSTOM CURSOR ──────────────────────────────── */
  .cursor-plus {
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    font-size: 20px;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--accent);
    opacity: 0;
    transform: translate(-50%, -50%) scale(.3);
    transition: opacity .12s, transform .12s var(--spring), color .2s;
    user-select: none;
    line-height: 1;
    letter-spacing: -1px;
    mix-blend-mode: multiply;
  }
  [data-theme="dark"] .cursor-plus { mix-blend-mode: normal; }
  .cursor-plus.show { opacity: 1; transform: translate(-50%,-50%) scale(1); }
  .cursor-plus.hovering {
    transform: translate(-50%,-50%) scale(1.8);
    color: var(--gold);
    font-weight: 700;
  }

  /* ── NAV ────────────────────────────────────────── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border-bottom: 1px solid var(--border);
    transition: background .4s var(--ease-out), border-color .4s;
  }

  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav .logo {
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -.03em;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity .2s;
  }
  nav .logo:hover { opacity: .75; }
  .logo-icon { width: 28px; height: 28px; flex-shrink: 0; overflow: hidden; }
  .logo-icon img { width: 28px; height: 28px; object-fit: contain; display: block; }
  .logo-accent { color: var(--accent); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: .1rem;
    list-style: none;
  }

  .nav-links a {
    text-decoration: none;
    font-family: var(--font-body);
    font-size: .83rem;
    font-weight: 500;
    color: var(--text3);
    padding: .45rem 1rem;
    border-radius: 6px;
    transition: color .2s, background .2s;
    letter-spacing: .01em;
  }
  .nav-links a:hover { color: var(--text); background: var(--tag-bg); }
  .nav-links a.active {
    color: var(--text);
    background: var(--tag-bg);
    font-weight: 600;
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
  }

  /* ── THEME TOGGLE ───────────────────────────────── */
  .toggle-wrap { display: flex; align-items: center; gap: 9px; }
  .toggle-label {
    font-size: .68rem;
    color: var(--text3);
    letter-spacing: .08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .toggle { position: relative; width: 42px; height: 24px; cursor: pointer; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-track {
    position: absolute; inset: 0;
    background: var(--paper-alt);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 100px;
    transition: background .3s;
  }
  .toggle input:checked + .toggle-track { background: var(--accent); }
  .toggle-thumb {
    position: absolute;
    top: 3px; left: 3px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--border-str);
    transition: transform .3s var(--spring);
    pointer-events: none;
  }
  [data-theme="dark"] .toggle-thumb { background: #fff; }
  .toggle input:checked ~ .toggle-thumb {
    transform: translateX(18px);
    background: var(--paper);
  }

  /* ── SECTION / PAGE ─────────────────────────────── */
  .section { max-width: var(--max); margin: 0 auto; padding: 4rem 2rem; }

  .section-label {
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 400;
    margin-bottom: .6rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 1px;
    background: var(--accent);
  }

  /* ── BUTTONS ────────────────────────────────────── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: .75rem 1.8rem;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-body);
    font-size: .87rem;
    font-weight: 600;
    border: 1.5px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: transform .2s var(--spring), box-shadow .2s, background .2s;
    box-shadow: 0 4px 14px rgba(26,48,86,.25);
    letter-spacing: .01em;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(26,48,86,.35);
    color: #fff;
  }
  .btn-primary:active { transform: translateY(0); }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: .75rem 1.8rem;
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    font-size: .87rem;
    font-weight: 600;
    border: 1.5px solid var(--border-str);
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: transform .2s var(--spring), box-shadow .2s, border-color .2s, background .2s;
  }
  .btn-outline:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--tag-bg);
    box-shadow: 0 6px 18px rgba(26,48,86,.12);
    color: var(--text);
  }

  /* ── LAYOUT ── */
  .page { min-height: 100vh; padding-top: var(--nav-h); }

  /* ── HERO ───────────────────────────────────────── */
  .hero {
    max-width: var(--max);
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5rem;
    align-items: center;
    min-height: calc(100vh - var(--nav-h));
    position: relative;
  }

  /* big decorative number */
  .hero-bg-num {
    position: absolute;
    right: -2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-head);
    font-size: clamp(14rem, 22vw, 22rem);
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    pointer-events: none;
    user-select: none;
    letter-spacing: -.08em;
    z-index: 0;
    opacity: .4;
  }

  .hero > * { position: relative; z-index: 1; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 400;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }
  .hero-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 2.5s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .4; transform: scale(.65); }
  }

  .hero h1 {
    font-family: var(--font-head);
    font-size: clamp(3rem, 5.5vw, 5.2rem);
    line-height: .97;
    letter-spacing: -.04em;
    color: var(--text);
    margin-bottom: 1.6rem;
    font-weight: 800;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 700;
  }

  .hero-sub {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text2);
    line-height: 1.8;
    margin-bottom: 2.2rem;
    max-width: 440px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .stat-num {
    font-family: var(--font-head);
    font-size: 1.9rem;
    color: var(--text);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -.02em;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: .62rem;
    color: var(--text3);
    margin-top: 5px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  /* ── PIN STACK ──────────────────────────────────── */
  .pin-preview-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .pin-card {
    background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 12px;
    overflow: hidden;
    transition: transform .25s var(--spring), box-shadow .25s;
    text-decoration: none;
    display: block;
    cursor: pointer;
  }
  .pin-card:hover {
    transform: translate(-4px, -4px) rotate(-.5deg);
    box-shadow: 8px 8px 0 var(--accent);
  }

  .pin-thumb {
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    border-bottom: 1px solid var(--border);
  }

  .th-green  { background: #1A3056; color: #fff; }
  .th-teal   { background: #203A64; color: #fff; }
  .th-navy   { background: #111827; color: #fff; }
  .th-olive  { background: #2a4b82; color: #fff; }
  .th-purple { background: #3a2d6b; color: #fff; }
  .th-gold   { background: #5c4200; color: #fff; }

  .pin-info { padding: 12px; }
  .pin-title { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.35; margin-bottom: 3px; }
  .pin-meta  { font-size: .65rem; color: var(--text3); }

  .pin-card.wide { grid-column: span 2; display: flex; flex-direction: row; }
  .pin-card.wide .pin-thumb { min-width: 80px; width: 80px; height: auto; border-bottom: none; border-right: 1px solid var(--border); flex-shrink: 0; }
  .pin-card.wide .pin-info  { flex: 1; display: flex; flex-direction: column; justify-content: center; }

  /* ── FEATURED CARDS ─────────────────────────────── */
  .featured-card {
    background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 16px;
    overflow: hidden;
    transition: transform .25s var(--spring), box-shadow .25s;
    cursor: pointer;
  }
  .featured-card:hover {
    transform: translate(-4px, -4px) rotate(-.3deg);
    box-shadow: 8px 8px 0 var(--accent);
  }

  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 280px;
  }

  .featured-content {
    padding: 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .featured-visual {
    background: var(--paper-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--border);
  }

  .featured-link {
    font-family: var(--font-mono);
    font-size: .78rem;
    color: var(--accent);
    font-weight: 400;
    text-decoration: none;
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: .04em;
  }
  .featured-link:hover { color: var(--gold); }

  /* ── CARDS STATUS ────────────────────────────────── */
  .card-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 1rem;
    border: 1px solid transparent;
  }
  .status-live   { background: rgba(26,48,86,.08); color: var(--accent); border-color: var(--border); }
  .status-building { background: rgba(200,168,75,.1); color: #8a6500; border-color: rgba(200,168,75,.3); }
  .status-soon   { background: var(--paper-alt); color: var(--text3); border-color: var(--border); }
  [data-theme="dark"] .status-building { color: var(--gold); }

  .status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .status-live .status-dot { animation: pulse 2s infinite; }

  .card-title {
    font-family: var(--font-head);
    font-size: 1.2rem;
    color: var(--text);
    letter-spacing: -.025em;
    margin-bottom: .5rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .card-desc { font-size: .84rem; color: var(--text2); line-height: 1.7; margin-bottom: 1.2rem; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 5px; }

  .tag {
    font-family: var(--font-mono);
    font-size: .6rem;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--paper-alt);
    color: var(--text);
    border: 1px solid var(--border);
    letter-spacing: .04em;
  }

  /* ── PROJECT CARDS ──────────────────────────────── */
  .project-card {
    background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 16px;
    padding: 1.8rem;
    transition: transform .25s var(--spring), box-shadow .25s;
    cursor: pointer;
    position: relative;
    overflow: hidden;
  }
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--gold-light) 0%, transparent 60%);
    opacity: 0;
    transition: opacity .3s;
  }
  .project-card:hover { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--accent); }
  .project-card:hover::before { opacity: 1; }

  .card-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    font-size: 1rem;
    color: var(--text3);
    transition: transform .3s var(--spring), color .3s;
  }
  .project-card:hover .card-arrow { transform: translate(4px, -4px); color: var(--accent); }

  /* ── BOT WIDGET ─────────────────────────────────── */
  .vis-bot {
    width: 205px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--border-str);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    animation: floatBot 4s ease-in-out infinite;
  }
  @keyframes floatBot {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }
  .vis-bot-bar {
    background: var(--ink);
    color: var(--paper);
    padding: 9px 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: .68rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }
  [data-theme="dark"] .vis-bot-bar { background: var(--accent); color: #fff; }
  .vis-bot-body { background: var(--card-bg); padding: 10px; display: flex; flex-direction: column; gap: 7px; }
  .vis-msg {
    padding: 7px 10px;
    border-radius: 8px;
    font-size: .68rem;
    line-height: 1.5;
    max-width: 88%;
    border: 1px solid var(--border);
    font-family: var(--font-body);
  }
  .vis-msg.user { background: var(--accent); color: #fff; border-color: transparent; align-self: flex-end; }
  .vis-msg.bot  { background: var(--paper-alt); color: var(--text); }

  /* ── BLOG GRID ──────────────────────────────────── */
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.2rem; }

  .blog-card {
    background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    transition: transform .25s var(--spring), box-shadow .25s;
    cursor: pointer;
  }
  .blog-card:hover { transform: translate(-4px, -4px) rotate(-.3deg); box-shadow: 8px 8px 0 var(--accent); }
  .blog-thumb { height: 160px; display: flex; align-items: center; justify-content: center; font-size: 2.4rem; border-bottom: 1px solid var(--border); }
  .blog-body  { padding: 1.3rem; }

  .blog-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .65rem;
    background: var(--paper-alt);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .blog-title {
    font-family: var(--font-head);
    font-size: 1.15rem;
    color: var(--text);
    line-height: 1.2;
    letter-spacing: -.025em;
    margin-bottom: .5rem;
    font-weight: 700;
  }

  .blog-excerpt { font-size: .82rem; color: var(--text2); line-height: 1.65; margin-bottom: .9rem; }
  .blog-meta { display: flex; align-items: center; gap: 7px; font-size: .7rem; color: var(--text3); font-weight: 500; font-family: var(--font-mono); }
  .blog-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text3); }

  /* ── BLOG POST ──────────────────────────────────── */
  .blogpost-back {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: .78rem; color: var(--text2);
    cursor: pointer; border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); border-radius: 6px;
    background: var(--card-bg); padding: .4rem .9rem;
    transition: all .2s var(--spring); margin-bottom: 1.5rem; text-decoration: none;
  }
  .blogpost-back:hover { transform: translateX(-4px); color: var(--accent); border-color: var(--accent); }

  .blogpost-category {
    display: inline-block; font-family: var(--font-mono);
    font-size: .65rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); font-weight: 400; margin-bottom: .8rem;
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); padding: 3px 8px; border-radius: 4px;
    background: var(--paper-alt);
  }

  .blogpost-title {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.0;
    letter-spacing: -.04em;
    color: var(--text);
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .blogpost-body { max-width: 680px; }
  .blogpost-body h2 { font-family: var(--font-head); font-size: 1.7rem; letter-spacing: -.025em; line-height: 1.2; color: var(--text); margin: 2.2rem 0 .8rem; font-weight: 700; }
  .blogpost-body h3 { font-family: var(--font-head); font-size: 1.25rem; color: var(--text); margin: 1.6rem 0 .6rem; font-weight: 700; }
  .blogpost-body p  { font-size: .97rem; color: var(--text2); line-height: 1.85; margin-bottom: 1.3rem; }
  .blogpost-body strong { color: var(--text); font-weight: 600; }
  .blogpost-body ul, .blogpost-body ol { padding-left: 1.4rem; margin-bottom: 1.2rem; }
  .blogpost-body li { font-size: .97rem; color: var(--text2); line-height: 1.8; margin-bottom: .3rem; }
  .blogpost-body a  { color: var(--accent); text-underline-offset: 3px; }

  /* ── ABOUT PAGE ─────────────────────────────────── */
  .about-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: 5rem; align-items: start; }
  .about-text h2 {
    font-family: var(--font-head);
    font-size: clamp(1.9rem, 3.5vw, 2.7rem);
    letter-spacing: -.03em;
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 1.3rem;
    font-weight: 800;
  }
  .about-text p { font-size: .94rem; color: var(--text2); line-height: 1.85; margin-bottom: 1rem; }
  .about-text p strong { color: var(--text); font-weight: 600; }
  .about-stack { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 1.8rem; }
  .stack-item { font-family: var(--font-mono); font-size: .72rem; color: var(--text); background: var(--paper-alt); padding: 5px 11px; border-radius: 5px; border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); letter-spacing: .03em; }

  .cost-list { display: flex; flex-direction: column; gap: 9px; }
  .cost-card {
    background: var(--card-bg); border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); border-radius: 10px;
    padding: .9rem 1.2rem; display: flex; align-items: center; justify-content: space-between;
  }
  .cost-name { font-size: .84rem; color: var(--text); font-weight: 600; }
  .cost-val  { font-size: .84rem; font-weight: 600; font-family: var(--font-mono); }
  .cost-val.free { color: var(--accent); }
  .cost-total { background: var(--paper-alt); border-color: var(--accent); }

  /* ── SCROLL PROGRESS BAR ────────────────────────── */
  #scroll-bar {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    background: var(--accent); transform-origin: left; transform: scaleX(0);
    z-index: 9999; transition: transform .05s linear;
    box-shadow: 0 0 8px var(--accent);
  }

  /* ── REVEAL ANIMATIONS ──────────────────────────── */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s var(--ease-out), transform .65s var(--ease-out); }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: .1s; }
  .reveal-delay-2 { transition-delay: .2s; }
  .reveal-delay-3 { transition-delay: .3s; }
  .reveal-delay-4 { transition-delay: .4s; }

  /* ── DIRECTIONAL REVEALS ──────────────────────────── */
  [data-reveal="left"]  { opacity: 0; transform: translateX(-36px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  [data-reveal="right"] { opacity: 0; transform: translateX(36px);  transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  [data-reveal="up"]    { opacity: 0; transform: translateY(36px);  transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  [data-reveal="scale"] { opacity: 0; transform: scale(0.88);       transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); }
  [data-reveal].in-view { opacity: 1; transform: none; }
  [data-reveal-delay="1"] { transition-delay: .1s; }
  [data-reveal-delay="2"] { transition-delay: .22s; }
  [data-reveal-delay="3"] { transition-delay: .38s; }
  [data-reveal-delay="4"] { transition-delay: .54s; }

  /* ── HERO ENTRANCE (CSS-only, no JS dependency) ─── */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-fade-in {
    animation: heroIn .75s cubic-bezier(.16,1,.3,1) both;
    animation-delay: var(--d, 0s);
  }

  /* ── FLOAT ───────────────────────────────────────── */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  /* ── OVERLAY BASE ────────────────────────────────── */
  .bc-overlay {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: rgba(0,0,0,.85); backdrop-filter: blur(6px);
    align-items: center; justify-content: center;
  }
  .bc-overlay.open { display: flex; }

  /* ── SPACE INVADERS OVERLAY ──────────────────────── */
  #game-overlay { flex-direction: column; gap: 10px; }
  #game-canvas  { border-radius: 12px; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 0 60px rgba(96,165,250,.18); display: block; }
  #game-hint    { font-family: var(--font-mono); font-size: .68rem; color: rgba(255,255,255,.35); letter-spacing: .08em; text-align: center; }
  #game-close   { font-family: var(--font-mono); font-size: .7rem; color: rgba(255,255,255,.35); background: none; border: 1px solid rgba(255,255,255,.15); border-radius: 6px; padding: 4px 16px; cursor: pointer; transition: all .2s; letter-spacing: .06em; }
  #game-close:hover { color: #fff; border-color: rgba(255,255,255,.5); }

  /* ── MATRIX OVERLAY ──────────────────────────────── */
  #matrix-overlay { cursor: pointer; }
  #matrix-canvas  { position: absolute; inset: 0; }
  #matrix-overlay::after { content: 'CLICK OR WAIT TO EXIT'; position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: .62rem; color: rgba(0,255,65,.35); letter-spacing: .2em; pointer-events: none; }

  /* ── TERMINAL OVERLAY ────────────────────────────── */
  #terminal-overlay { align-items: flex-end; justify-content: flex-end; padding: 1.5rem; background: transparent; backdrop-filter: none; pointer-events: none; }
  #terminal-overlay.open { pointer-events: all; }
  #terminal-box { width: 400px; max-width: calc(100vw - 2rem); background: #0d1117; border: 1px solid rgba(74,222,128,.25); border-radius: 12px; overflow: hidden; box-shadow: 0 0 40px rgba(74,222,128,.12), 0 24px 60px rgba(0,0,0,.7); font-family: var(--font-mono); }
  #terminal-bar { background: #161b22; padding: 8px 14px; display: flex; align-items: center; gap: 7px; border-bottom: 1px solid rgba(74,222,128,.1); }
  .term-dot { width: 10px; height: 10px; border-radius: 50%; }
  #terminal-title { color: rgba(255,255,255,.35); font-size: .68rem; letter-spacing: .08em; margin-left: auto; }
  #terminal-output { padding: 12px 14px; height: 200px; overflow-y: auto; color: #e2e8f0; line-height: 1.75; font-size: .76rem; scrollbar-width: thin; scrollbar-color: rgba(74,222,128,.2) transparent; }
  #terminal-input-row { display: flex; align-items: center; gap: 8px; padding: 7px 14px; border-top: 1px solid rgba(74,222,128,.1); }
  #terminal-prompt { color: #4ade80; font-size: .76rem; flex-shrink: 0; }
  #terminal-input { flex: 1; background: none; border: none; outline: none; color: #f1f5f9; font-family: var(--font-mono); font-size: .76rem; caret-color: #4ade80; }

  /* ── FOOTER ─────────────────────────────────────── */
  footer { border-top: 1px solid var(--border); margin-top: 1rem; }
  .footer-inner {
    max-width: var(--max); margin: 0 auto;
    padding: 1.6rem 2rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  .footer-left { font-size: .75rem; color: var(--text2); font-family: var(--font-mono); }
  .footer-left strong { color: var(--text); }
  .footer-right { display: flex; gap: 1.4rem; }
  .footer-right a {
    font-family: var(--font-mono);
    font-size: .72rem; color: var(--text3); font-weight: 400;
    text-decoration: none; transition: color .2s; letter-spacing: .04em;
  }
  .footer-right a:hover { color: var(--accent); }

  /* ── ADMIN PANEL ────────────────────────────────── */
  #admin-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.55); backdrop-filter: blur(8px);
  }
  #admin-overlay.open { display: flex; align-items: stretch; }
  #admin-panel {
    width: 100%; max-width: 860px; margin: auto;
    background: var(--paper); border-radius: 16px;
    overflow: hidden; display: flex; flex-direction: column;
    max-height: 90vh; border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    box-shadow: 0 32px 80px rgba(0,0,0,.3);
  }
  .admin-topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--border);
    flex-shrink: 0; background: var(--card-bg);
  }
  .admin-topbar h2 { font-family: var(--font-head); font-size: 1.2rem; color: var(--text); font-weight: 700; }
  .admin-topbar-right { display: flex; align-items: center; gap: 10px; }
  .admin-close {
    background: none; border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); border-radius: 6px;
    font-size: 1.1rem; cursor: pointer; color: var(--text);
    transition: all .2s; padding: 3px 9px;
  }
  .admin-close:hover { transform: rotate(90deg); border-color: var(--accent); color: var(--accent); }
  .admin-tabs {
    display: flex; gap: 4px; padding: .8rem 1.4rem;
    border-bottom: 1px solid var(--border); flex-shrink: 0;
    overflow-x: auto; background: var(--card-bg);
  }
  .admin-tab {
    background: none; border: 1px solid transparent;
    font-family: var(--font-mono); font-size: .75rem;
    color: var(--text2); cursor: pointer;
    padding: .35rem .9rem; border-radius: 5px;
    transition: all .2s; white-space: nowrap; letter-spacing: .04em;
  }
  .admin-tab.active { background: var(--accent); color: #fff; border-color: transparent; }
  .admin-body { overflow-y: auto; flex: 1; padding: 1.6rem; }
  .admin-section { display: none; }
  .admin-section.active { display: block; }
  .admin-label {
    font-family: var(--font-mono); font-size: .65rem;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--text); font-weight: 400;
    margin-bottom: .4rem; margin-top: 1.2rem;
  }
  .admin-label:first-child { margin-top: 0; }
  .admin-input, .admin-textarea, .admin-select {
    width: 100%; background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); border-radius: 7px;
    padding: .6rem .9rem; font-family: var(--font-body);
    font-size: .87rem; color: var(--text);
    transition: border-color .2s; outline: none;
  }
  .admin-input:focus, .admin-textarea:focus, .admin-select:focus { border-color: var(--accent); }
  .admin-textarea { min-height: 100px; resize: vertical; line-height: 1.6; }
  .admin-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .admin-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: .55rem 1.2rem; background: var(--accent); color: #fff;
    border: 1.5px solid transparent; border-radius: 7px;
    font-family: var(--font-body); font-size: .82rem; font-weight: 600;
    cursor: pointer; transition: transform .2s, box-shadow .2s;
    box-shadow: 0 2px 8px rgba(26,48,86,.2);
  }
  .admin-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(26,48,86,.3); }
  .admin-btn.secondary { background: var(--paper-alt); color: var(--text); box-shadow: none; border-color: var(--border-str); }
  .admin-divider { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }
  .admin-card-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.2rem; }
  .admin-item {
    background: var(--card-bg); border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 8px; padding: .8rem 1rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .admin-item-info { flex: 1; min-width: 0; }
  .admin-item-title { font-size: .85rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .admin-item-sub { font-size: .72rem; color: var(--text3); margin-top: 2px; }
  .admin-item-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .admin-icon-btn {
    background: var(--paper-alt); border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); border-radius: 5px;
    padding: 4px 8px; cursor: pointer; font-size: .75rem; color: var(--text);
    transition: all .2s; font-family: var(--font-mono);
  }
  .admin-icon-btn:hover { transform: translateY(-1px); border-color: var(--accent); }
  .admin-icon-btn.del:hover { color: #c0392b; border-color: #c0392b; }
  .admin-notice {
    background: var(--paper-alt); border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 7px; padding: .7rem 1rem;
    font-size: .82rem; color: var(--text); margin-bottom: 1.2rem;
  }
  .admin-save-bar {
    padding: 1rem 1.6rem; border-top: 1px solid var(--border);
    display: flex; justify-content: flex-end; gap: 10px;
    flex-shrink: 0; background: var(--card-bg);
  }
  .admin-color-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: .5rem; }
  .color-opt {
    width: 30px; height: 30px; border-radius: 5px; cursor: pointer;
    border: 1.5px solid var(--border-str); transition: transform .2s var(--spring), box-shadow .2s;
  }
  .color-opt:hover, .color-opt.selected {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .admin-select { cursor: pointer; }

  #admin-trigger {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 150;
    width: 48px; height: 48px; border-radius: 10px;
    background: var(--card-bg); color: var(--text);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
    transition: transform .2s var(--spring), box-shadow .2s;
  }
  #admin-trigger:hover { transform: translateY(-3px) rotate(20deg); box-shadow: 0 8px 24px rgba(0,0,0,.18); }

  #admin-login {
    position: fixed; inset: 0; z-index: 300;
    background: rgba(0,0,0,.6); backdrop-filter: blur(10px);
    display: none; align-items: center; justify-content: center;
  }
  #admin-login.open { display: flex; }
  .login-box {
    background: var(--paper); border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 16px; padding: 2.5rem 2rem; width: 340px;
    text-align: center; box-shadow: 0 32px 80px rgba(0,0,0,.3);
  }
  .login-box h3 { font-family: var(--font-head); font-size: 1.6rem; color: var(--text); margin-bottom: .6rem; font-weight: 800; }
  .login-box p { font-size: .86rem; color: var(--text2); margin-bottom: 1.5rem; line-height: 1.6; }
  .login-error { font-family: var(--font-mono); font-size: .75rem; color: #c0392b; margin-top: .5rem; display: none; }

  /* ── PAGE HEADERS ── */
  .page-header { padding: 3.5rem 2rem 0; max-width: 1100px; margin: 0 auto; }
  .page-header h1 { font-family: var(--font-head); font-size: clamp(2.2rem,5vw,3.6rem); letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 0.8rem; }
  .page-header p { font-size: 1rem; color: var(--text2); font-weight: 400; max-width: 500px; line-height: 1.7; }

  /* ── RESPONSIVE ─────────────────────────────────── */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 3rem; min-height: auto; padding: 3.5rem 1.5rem 2.5rem; }
    .hero-bg-num { display: none; }
    .featured-inner { grid-template-columns: 1fr; }
    .featured-visual { min-height: 180px; border-left: none; border-top: 1px solid var(--border); }
    .about-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .home-two-col { grid-template-columns: 1fr !important; }
    .admin-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .nav-links a { padding: .4rem .5rem; font-size: .75rem; }
    .section { padding: 2.5rem 1.5rem; }
    .hero-stats { gap: 1.5rem; }
    #admin-panel { max-height: 95vh; border-radius: 12px 12px 0 0; margin: auto auto 0; }
    .footer-inner { flex-direction: column; gap: .75rem; text-align: center; }
    .footer-right { justify-content: center; }
  }

  @media (hover: none) and (pointer: coarse) {
    body { cursor: default; }
    .cursor-plus { display: none !important; }
  }

  @supports (padding: max(0px)) {
    nav { padding-left: max(0px, env(safe-area-inset-left)); padding-right: max(0px, env(safe-area-inset-right)); }
    body { padding-bottom: env(safe-area-inset-bottom); }
  }
</style>
</head>
<body>

<div id="scroll-bar"></div>
<div class="cursor-plus" id="cursor-plus">+</div>

<!-- ░░ HIDDEN GAME: Space Invaders (Konami code) ░░ -->
<div id="game-overlay" class="bc-overlay">
  <canvas id="game-canvas"></canvas>
  <div id="game-hint"></div>
  <button id="game-close" onclick="document.getElementById('game-overlay').classList.remove('open')">ESC / close</button>
</div>

<!-- ░░ HIDDEN: Matrix rain (click logo ×5) ░░ -->
<div id="matrix-overlay" class="bc-overlay">
  <canvas id="matrix-canvas"></canvas>
</div>

<!-- ░░ HIDDEN: Terminal easter egg (type "bharcode") ░░ -->
<div id="terminal-overlay" class="bc-overlay">
  <div id="terminal-box">
    <div id="terminal-bar">
      <div class="term-dot" style="background:#ff5f57"></div>
      <div class="term-dot" style="background:#ffbd2e"></div>
      <div class="term-dot" style="background:#28ca41"></div>
      <span id="terminal-title">bharcode — terminal</span>
    </div>
    <div id="terminal-output"></div>
    <div id="terminal-input-row">
      <span id="terminal-prompt">$</span>
      <input id="terminal-input" type="text" autocomplete="off" spellcheck="false" placeholder="type a command…">
    </div>
  </div>
</div>

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <span class="logo-icon" aria-hidden="true">
        <picture>
          <source srcset="/assets/logo.webp" type="image/webp">
          <img
            src="/assets/logo.png"
            alt=""
            width="28"
            height="28"
            onerror="this.closest('.logo-icon').style.display='none'"
          >
        </picture>
      </span>
      <span><span class="logo-accent">Bhar</span>code</span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class:list={[{ active: Astro.url.pathname === '/' }]}>Home</a></li>
      <li><a href="/work" class:list={[{ active: Astro.url.pathname === '/work' }]}>Work</a></li>
      <li><a href="/blog" class:list={[{ active: Astro.url.pathname.startsWith('/blog') }]}>Blog</a></li>
      <li><a href="/apps" class:list={[{ active: Astro.url.pathname === '/apps' }]}>Apps</a></li>
      <li><a href="/about" class:list={[{ active: Astro.url.pathname === '/about' }]}>About</a></li>
    </ul>
    <div class="toggle-wrap">
      <span class="toggle-label" id="theme-label">Light</span>
      <label class="toggle" aria-label="Toggle dark mode">
        <input type="checkbox" id="theme-toggle">
        <div class="toggle-track"></div>
        <div class="toggle-thumb"></div>
      </label>
    </div>
  </div>
</nav>

