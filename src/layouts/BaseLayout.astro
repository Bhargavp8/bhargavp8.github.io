---
import AdminPanel from '../components/AdminPanel.astro';
import data from '../../public/data.json';
const { general, links } = data;
const {
  title = "BharCode — Product Engineer · CS Student · Singapore",
  description = "CS student in Singapore building AI-powered products end-to-end. Follow the build log for real technical decisions, project deep-dives, and what it takes to ship.",
  ogImage = "https://bharcode.com/assets/logo.png",
  ogUrl = "https://bharcode.com/"
} = Astro.props;

const currentPath = Astro.url.pathname;
const mobileNavLinks = [
  { href: '/', label: 'Home', num: '01', active: currentPath === '/' },
  { href: '/work', label: 'Work', num: '02', active: currentPath === '/work' },
  { href: '/blog', label: 'Blog', num: '03', active: currentPath.startsWith('/blog') },
  { href: '/apps', label: 'Apps', num: '04', active: currentPath === '/apps' },
  { href: '/about', label: 'About', num: '05', active: currentPath === '/about' },
];
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="alternate" type="application/rss+xml" title="Bharcode RSS Feed" href="/rss.xml">
<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="icon" type="image/png" sizes="512x512" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">
<link rel="icon" type="image/webp" sizes="64x64" href="/assets/favicon-64.webp">
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={ogUrl}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<!-- Theme must be applied before paint to avoid flash of wrong theme.
     The `js` class gates scroll-reveal hiding: if JS never runs, nothing hides. -->
<script is:inline>
  (function() {
    document.documentElement.classList.add('js');
    const savedTheme = localStorage.getItem('bharcode-theme');
    if (savedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Hanken+Grotesk:ital,wght@0,300..700;1,400..500&family=JetBrains+Mono:wght@400;500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">

<style is:global>
  /* ═══════════════════════════════════════════════════
     BHARCODE V3 — AURORA & INK
     Palette drawn from the hand-sketched navy B logo:
     navy ink, cream paper, sky-blue, clay accent.
     Smooth aurora atmosphere + rough hand-drawn edges.
     ═══════════════════════════════════════════════════ */
  :root {
    /* ── NIGHT AURORA (default) ── */
    --ink:        #0A1120;   /* deepest backdrop */
    --paper:      #0D1526;   /* page background */
    --paper-alt:  #16223B;   /* raised surface */
    --accent:     #6B97D8;   /* sky-blue ink (primary on dark) */
    --accent2:    #8FB3E8;   /* sky highlight */
    --accent-cool:#6B97D8;
    --accent-cool2:#9CC6FF;
    --gold:       #C97A55;   /* clay — warm counterpoint */
    --gold-light: rgba(201,122,85,.16);
    --glow-gold:  rgba(201,122,85,.30);
    --glow-cool:  rgba(107,151,216,.32);
    --border:     rgba(240,236,225,.14);
    --border-str: rgba(240,236,225,.32);
    --card-bg:    rgba(22,34,59,.74);
    --card-bg2:   rgba(22,34,59,.55);
    --bg-alt:     rgba(12,21,40,.45);
    --nav-bg:     rgba(10,17,32,.68);
    --text:       #F2EFE6;   /* cream, straight off the logo paper */
    --text2:      #B9C4D6;
    --text3:      #8290A6;
    --tag-bg:     rgba(107,151,216,.12);
    --sketch:     rgba(226,229,238,.55); /* hand-drawn line colour */

    /* Fonts */
    --font-head:  'Fraunces', Georgia, serif;
    --font-body:  'Hanken Grotesk', system-ui, sans-serif;
    --font-mono:  'JetBrains Mono', ui-monospace, monospace;
    --font-hand:  'Caveat', 'Comic Sans MS', cursive;

    /* Easing */
    --spring:     cubic-bezier(.34,1.4,.64,1);
    --ease-out:   cubic-bezier(.16,1,.3,1);

    /* Grid */
    --max:        1160px;
    --nav-h:      64px;
  }

  /* ── PAPER AURORA (light) ── */
  [data-theme="light"] {
    --ink:        #16233C;
    --paper:      #FAF7EE;   /* cream paper, straight off the logo */
    --paper-alt:  #F0EBDD;
    --accent:     #1C3356;   /* the logo's navy */
    --accent2:    #2E4E82;
    --accent-cool:#2E4E82;
    --accent-cool2:#5A8EE0;
    --gold:       #C56B4A;   /* clay */
    --gold-light: rgba(197,107,74,.14);
    --glow-gold:  rgba(197,107,74,.22);
    --glow-cool:  rgba(46,78,130,.16);
    --border:     rgba(28,51,86,.15);
    --border-str: rgba(28,51,86,.35);
    --card-bg:    rgba(255,255,255,.72);
    --card-bg2:   rgba(255,255,255,.55);
    --bg-alt:     rgba(255,255,255,.38);
    --nav-bg:     rgba(250,247,238,.75);
    --text:       #16233C;
    --text2:      #44506A;
    --text3:      #7A8499;
    --tag-bg:     rgba(28,51,86,.07);
    --sketch:     rgba(28,51,86,.6);
  }

  /* ── RESET ──────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; font-size: 16px; }

  body {
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    transition: background .5s var(--ease-out), color .4s var(--ease-out);
  }

  /* ── AURORA FIELD: soft colour blooms, fixed behind content ── */
  .bg-field { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .bg-field span {
    position: absolute; border-radius: 50%;
    filter: blur(90px);
    will-change: transform;
  }
  .bg-field .au1 { width: 56vw; height: 56vw; right: -12vw; top: -22vw;  background: #3A6FC0; opacity: .55; }
  .bg-field .au2 { width: 42vw; height: 42vw; right: 4vw;   top: 12vw;   background: #A4553A; opacity: .30; }
  .bg-field .au3 { width: 44vw; height: 44vw; left: -14vw;  top: -6vw;   background: #6EA0E6; opacity: .32; }
  .bg-field .au4 { width: 40vw; height: 40vw; left: 24vw;   bottom: -26vw; background: #2B8F8A; opacity: .20; }
  [data-theme="light"] .bg-field .au1 { background: #8FB3E0; opacity: .42; }
  [data-theme="light"] .bg-field .au2 { background: #E0A487; opacity: .34; }
  [data-theme="light"] .bg-field .au3 { background: #A9C6EF; opacity: .38; }
  [data-theme="light"] .bg-field .au4 { background: #7FC2BD; opacity: .22; }

  /* ── PAPER GRAIN (matches the logo's paper texture) ── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.03'/%3E%3C/svg%3E");
    background-size: 256px;
    pointer-events: none;
    z-index: 2;
    opacity: .5;
    mix-blend-mode: overlay;
  }
  main, nav, footer { position: relative; z-index: 3; }

  /* ═══════════════════════════════════════════════════
     SKETCH SYSTEM — rough hand-inked borders everywhere.
     Two displaced strokes per box = a real double-pass
     pencil line, like the logo's charcoal outline.
     Filters #sk-a/#sk-b/#sk-c live in an inline <svg>.
     ═══════════════════════════════════════════════════ */
  .sk-box { position: relative; border: none !important; }
  .sk-box::before, .sk-box::after {
    content: ''; position: absolute; inset: 2px;
    border-radius: inherit; pointer-events: none; z-index: 1;
  }
  .sk-box::before { border: 1.8px solid var(--sketch); filter: url(#sk-a); }
  .sk-box::after  { border: 1.3px solid var(--sketch); filter: url(#sk-b); opacity: .45; transform: rotate(.35deg) scale(1.004); }
  .sk-box > * { position: relative; z-index: 2; }

  /* hand-drawn horizontal rule */
  .sk-rule { border: none; height: 2px; background: var(--sketch); filter: url(#sk-b); opacity: .7; }

  /* handwritten margin notes */
  .hand-note {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--gold);
    letter-spacing: .01em;
  }

  /* ── NAV ────────────────────────────────────────── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    border-bottom: 1px solid var(--border);
    transition: background .4s var(--ease-out), border-color .4s;
  }

  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 2rem;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav .logo {
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -.03em;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity .2s;
  }
  nav .logo:hover { opacity: .75; }
  .logo-icon { width: 30px; height: 30px; flex-shrink: 0; overflow: hidden; border-radius: 7px; }
  .logo-icon img { width: 30px; height: 30px; object-fit: contain; display: block; }
  .logo-accent { color: var(--accent); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: .35rem;
    list-style: none;
  }

  .nav-links a {
    text-decoration: none;
    font-family: var(--font-body);
    font-size: .83rem;
    font-weight: 500;
    color: var(--text3);
    padding: .45rem .9rem;
    border-radius: 6px;
    transition: color .2s;
    letter-spacing: .01em;
    position: relative;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); font-weight: 600; }
  /* the active page gets a wobbly hand-drawn underline */
  .nav-links a.active::after {
    content: ''; position: absolute; left: .7rem; right: .7rem; bottom: 2px;
    border-bottom: 2px solid var(--accent);
    filter: url(#sk-b);
  }

  /* ── THEME TOGGLE ───────────────────────────────── */
  .toggle-wrap { display: flex; align-items: center; gap: 9px; }
  .toggle-label {
    font-size: .68rem;
    color: var(--text3);
    letter-spacing: .08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
  }
  .toggle { position: relative; width: 42px; height: 24px; cursor: pointer; }
  .toggle input { opacity: 0; width: 0; height: 0; }
  .toggle-track {
    position: absolute; inset: 0;
    background: var(--paper-alt);
    border: 1.5px solid var(--border-str);
    border-radius: 100px;
    transition: background .3s;
  }
  .toggle input:checked + .toggle-track { background: var(--accent); }
  .toggle-thumb {
    position: absolute;
    top: 4px; left: 4px;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--border-str);
    transition: transform .3s var(--spring);
    pointer-events: none;
  }
  [data-theme="dark"] .toggle-thumb { background: #fff; }
  .toggle input:checked ~ .toggle-thumb {
    transform: translateX(18px);
    background: var(--paper);
  }

  /* ── SECTION / PAGE ─────────────────────────────── */
  .section { max-width: var(--max); margin: 0 auto; padding: 4rem 2rem; }

  .section-label {
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 400;
    margin-bottom: .6rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 2px;
    background: var(--gold);
    filter: url(#sk-b);
  }

  /* ── BUTTONS — solid fill, hand-inked outline ───── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: .8rem 1.7rem;
    background: var(--accent);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: .87rem;
    font-weight: 650;
    border: none;
    border-radius: 9px;
    cursor: pointer;
    text-decoration: none;
    transition: transform .25s var(--spring), box-shadow .25s, filter .2s;
    box-shadow: 0 8px 26px -8px var(--glow-cool);
    letter-spacing: .005em;
    position: relative;
  }
  .btn-primary::before {
    content: ''; position: absolute; inset: 2px; border-radius: inherit;
    border: 1.6px solid var(--paper); opacity: .5;
    filter: url(#sk-b); pointer-events: none;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -8px var(--glow-cool);
    filter: brightness(1.06);
    color: var(--ink);
  }
  [data-theme="light"] .btn-primary { color: #fff; box-shadow: 0 8px 26px -8px rgba(28,51,86,.4); }
  .btn-primary:active { transform: translateY(0); }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: .75rem 1.8rem;
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    font-size: .87rem;
    font-weight: 600;
    border: none;
    border-radius: 9px;
    cursor: pointer;
    text-decoration: none;
    transition: transform .2s var(--spring), color .2s, background .2s;
    position: relative;
  }
  .btn-outline::before {
    content: ''; position: absolute; inset: 1px; border-radius: inherit;
    border: 1.8px solid var(--sketch);
    filter: url(#sk-a); pointer-events: none;
    transition: border-color .2s;
  }
  .btn-outline:hover { transform: translateY(-2px); background: var(--tag-bg); color: var(--text); }
  .btn-outline:hover::before { border-color: var(--accent); }

  /* ── LAYOUT ── */
  .page { min-height: 100vh; padding-top: var(--nav-h); }

  /* ── HERO ───────────────────────────────────────── */
  .hero {
    max-width: var(--max);
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5rem;
    align-items: center;
    min-height: calc(92vh - var(--nav-h));
    position: relative;
  }
  .hero > * { position: relative; z-index: 1; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: .72rem;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 1.5rem;
  }
  .hero-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--gold);
    animation: pulse 2.5s ease infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: .4; transform: scale(.65); }
  }

  .hero h1 {
    font-family: var(--font-head);
    font-size: clamp(3rem, 5.5vw, 5rem);
    line-height: .99;
    letter-spacing: -.035em;
    color: var(--text);
    margin-bottom: 1.6rem;
    font-weight: 640;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--accent);
    font-weight: 560;
    position: relative;
    white-space: nowrap;
  }
  /* rough clay underline sits under the italic line */
  .hero h1 em .sk-underline {
    position: absolute; left: -2%; right: -2%; bottom: -.18em; height: .22em;
    pointer-events: none;
  }

  .hero-sub {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text2);
    line-height: 1.8;
    margin-bottom: 2.2rem;
    max-width: 440px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    position: relative;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    padding-top: 2rem;
    border-top: none;
    position: relative;
  }
  .hero-stats::before {
    content: ''; position: absolute; top: 0; left: 0; width: min(360px, 90%);
    border-top: 2px solid var(--sketch); filter: url(#sk-b); opacity: .6;
  }

  .stat-num {
    font-family: var(--font-head);
    font-size: 1.9rem;
    color: var(--text);
    line-height: 1;
    font-weight: 640;
    letter-spacing: -.02em;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: .62rem;
    color: var(--text3);
    margin-top: 5px;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  /* big hand-sketched B watermark (right column of the hero) */
  .hero-bmark { display: flex; align-items: center; justify-content: center; position: relative; }
  .hero-bmark svg { width: min(340px, 80%); height: auto; opacity: .9; }
  .hero-bmark .hand-note { position: absolute; bottom: 6%; right: 8%; transform: rotate(-6deg); }

  /* ── PIN STACK (latest posts on home) ───────────── */
  .pin-preview-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .pin-card {
    background: var(--card-bg);
    border-radius: 12px;
    overflow: hidden;
    transition: transform .25s var(--spring);
    text-decoration: none;
    display: block;
    cursor: pointer;
    position: relative;
  }
  .pin-card::before, .pin-card::after {
    content: ''; position: absolute; inset: 2px; border-radius: 10px; pointer-events: none; z-index: 3;
  }
  .pin-card::before { border: 1.6px solid var(--sketch); filter: url(#sk-a); }
  .pin-card::after  { border: 1.2px solid var(--sketch); filter: url(#sk-b); opacity: .4; }
  .pin-card:hover { transform: translateY(-4px) rotate(-.4deg); }

  .pin-thumb {
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    border-bottom: 1px solid var(--border);
  }

  .th-green  { background: #1C3356; color: #fff; }
  .th-teal   { background: #24486E; color: #fff; }
  .th-navy   { background: #12203A; color: #fff; }
  .th-olive  { background: #2E4E82; color: #fff; }
  .th-purple { background: #3A2D6B; color: #fff; }
  .th-gold   { background: #7A4630; color: #fff; }

  .pin-info { padding: 12px; }
  .pin-title { font-size: .78rem; font-weight: 600; color: var(--text); line-height: 1.35; margin-bottom: 3px; }
  .pin-meta  { font-size: .65rem; color: var(--text3); }

  .pin-card.wide { grid-column: span 2; display: flex; flex-direction: row; }
  .pin-card.wide .pin-thumb { min-width: 80px; width: 80px; height: auto; border-bottom: none; border-right: 1px solid var(--border); flex-shrink: 0; }
  .pin-card.wide .pin-info  { flex: 1; display: flex; flex-direction: column; justify-content: center; }

  /* ── FEATURED CARDS ─────────────────────────────── */
  .featured-card {
    background: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    transition: transform .25s var(--spring);
    cursor: pointer;
    position: relative;
  }
  .featured-card::before, .featured-card::after {
    content: ''; position: absolute; inset: 2px; border-radius: 14px; pointer-events: none; z-index: 3;
  }
  .featured-card::before { border: 1.8px solid var(--sketch); filter: url(#sk-a); }
  .featured-card::after  { border: 1.3px solid var(--sketch); filter: url(#sk-c); opacity: .4; }
  .featured-card:hover { transform: translateY(-4px) rotate(-.25deg); }

  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 280px;
  }

  .featured-content {
    padding: 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .featured-visual {
    background: var(--bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid var(--border);
  }

  .featured-link {
    font-family: var(--font-mono);
    font-size: .78rem;
    color: var(--accent);
    font-weight: 400;
    text-decoration: none;
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: .04em;
  }
  .featured-link:hover { color: var(--gold); }

  /* ── BUILD-LOG WIDGET ── */
  .vis-log {
    width: 210px; max-width: 88%;
    border-radius: 12px; overflow: hidden;
    border: 1px solid var(--border-str);
    background: #0A0F1B;
    box-shadow: 0 16px 36px -14px rgba(0,0,0,.7);
    font-family: var(--font-mono);
  }
  .vis-log-bar {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 11px; background: rgba(255,255,255,.04);
    border-bottom: 1px solid var(--border);
    font-size: .6rem; color: var(--text2); letter-spacing: .04em;
  }
  .vlb-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .vlb-dot.r { background: #ff5f57; } .vlb-dot.y { background: #ffbd2e; } .vlb-dot.g { background: #28ca41; }
  .vlb-name { margin-left: 5px; color: var(--text3); }
  .vis-log-body { padding: 11px; display: flex; flex-direction: column; gap: 8px; }
  .vis-log-line {
    font-size: .6rem; color: #B9C4D6; line-height: 1.3;
    display: flex; align-items: center; gap: 7px; white-space: nowrap;
  }
  .vll-t { color: #8290A6; width: 22px; flex-shrink: 0; }
  .vll-ok   { color: #4ade80; font-weight: 600; }
  .vll-add  { color: #8FB3E8; font-weight: 600; }
  .vll-warn { color: #C97A55; font-weight: 600; }
  .vll-cmd { color: #F2EFE6; margin-top: 1px; }
  .vll-prompt { color: #C97A55; }
  .vll-caret {
    display: inline-block; width: 6px; height: 11px; margin-left: 2px;
    background: #8FB3E8; vertical-align: middle;
    animation: vllBlink 1.1s steps(1) infinite;
  }
  @keyframes vllBlink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .vll-caret { animation: none; } }

  /* ── CARDS STATUS ────────────────────────────────── */
  .card-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    margin-bottom: 1rem;
    border: 1.3px solid transparent;
  }
  .status-live     { background: rgba(74,222,128,.09); color: #3a9d5d; border-color: rgba(74,222,128,.35); }
  [data-theme="dark"] .status-live { color: #4ade80; }
  .status-building { background: var(--gold-light); color: var(--gold); border-color: var(--gold); }
  .status-soon     { background: var(--paper-alt); color: var(--text3); border-color: var(--border); }

  .status-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .status-live .status-dot { animation: pulse 2s infinite; }

  .card-title {
    font-family: var(--font-head);
    font-size: 1.2rem;
    color: var(--text);
    letter-spacing: -.025em;
    margin-bottom: .5rem;
    line-height: 1.2;
    font-weight: 640;
  }

  .card-desc { font-size: .84rem; color: var(--text2); line-height: 1.7; margin-bottom: 1.2rem; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 5px; }

  .tag {
    font-family: var(--font-mono);
    font-size: .6rem;
    padding: 3px 9px;
    border-radius: 20px;
    background: transparent;
    color: var(--accent);
    border: 1.3px solid var(--accent);
    opacity: .85;
    letter-spacing: .04em;
  }

  /* ── PROJECT CARDS ──────────────────────────────── */
  .project-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 1.8rem;
    transition: transform .25s var(--spring);
    cursor: pointer;
    position: relative;
  }
  .project-card::before, .project-card::after {
    content: ''; position: absolute; inset: 2px; border-radius: 14px; pointer-events: none;
  }
  .project-card::before { border: 1.8px solid var(--sketch); filter: url(#sk-a); }
  .project-card::after  { border: 1.3px solid var(--sketch); filter: url(#sk-b); opacity: .45; transform: rotate(.3deg); }
  .project-card:hover { transform: translateY(-4px); }

  .card-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    font-size: 1rem;
    color: var(--text3);
    transition: transform .3s var(--spring), color .3s;
  }
  .project-card:hover .card-arrow { transform: translate(4px, -4px); color: var(--gold); }

  /* ── BOT WIDGET ─────────────────────────────────── */
  .vis-bot {
    width: 205px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-str);
    box-shadow: 0 16px 36px -16px rgba(0,0,0,.5);
  }
  @keyframes floatBot {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }
  .vis-bot-bar {
    background: var(--accent);
    color: var(--ink);
    padding: 9px 12px;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: .68rem;
    font-weight: 600;
    font-family: var(--font-mono);
  }
  [data-theme="light"] .vis-bot-bar { color: #fff; }
  .vis-bot-body { background: var(--card-bg); padding: 10px; display: flex; flex-direction: column; gap: 7px; }
  .vis-msg {
    padding: 7px 10px;
    border-radius: 8px;
    font-size: .68rem;
    line-height: 1.5;
    max-width: 88%;
    border: 1px solid var(--border);
    font-family: var(--font-body);
  }
  .vis-msg.user { background: var(--accent); color: var(--ink); border-color: transparent; align-self: flex-end; }
  [data-theme="light"] .vis-msg.user { color: #fff; }
  .vis-msg.bot  { background: var(--paper-alt); color: var(--text); }

  /* ── BLOG GRID ──────────────────────────────────── */
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.2rem; }

  .blog-card {
    background: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    transition: transform .25s var(--spring);
    cursor: pointer;
    position: relative;
  }
  .blog-card::before, .blog-card::after {
    content: ''; position: absolute; inset: 2px; border-radius: 14px; pointer-events: none; z-index: 3;
  }
  .blog-card::before { border: 1.7px solid var(--sketch); filter: url(#sk-b); }
  .blog-card::after  { border: 1.2px solid var(--sketch); filter: url(#sk-a); opacity: .4; transform: rotate(-.3deg); }
  .blog-card:hover { transform: translateY(-4px) rotate(-.3deg); }
  .blog-thumb { height: 160px; display: flex; align-items: center; justify-content: center; font-size: 2.4rem; border-bottom: 1px solid var(--border); }
  .blog-body  { padding: 1.3rem; }

  .blog-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: .6rem;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: .65rem;
    border: 1.3px solid var(--gold);
    padding: 2px 8px;
    border-radius: 20px;
    opacity: .9;
  }

  .blog-title {
    font-family: var(--font-head);
    font-size: 1.15rem;
    color: var(--text);
    line-height: 1.2;
    letter-spacing: -.025em;
    margin-bottom: .5rem;
    font-weight: 640;
  }

  .blog-excerpt { font-size: .82rem; color: var(--text2); line-height: 1.65; margin-bottom: .9rem; }
  .blog-meta { display: flex; align-items: center; gap: 7px; font-size: .7rem; color: var(--text3); font-weight: 500; font-family: var(--font-mono); }
  .blog-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text3); }

  /* ── BLOG POST ──────────────────────────────────── */
  .blogpost-back {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: .78rem; color: var(--text2);
    cursor: pointer; border-radius: 8px;
    background: var(--card-bg); padding: .45rem 1rem;
    transition: all .2s var(--spring); margin-bottom: 1.5rem; text-decoration: none;
    position: relative;
  }
  .blogpost-back::before {
    content: ''; position: absolute; inset: 1px; border-radius: inherit;
    border: 1.5px solid var(--sketch); filter: url(#sk-b); pointer-events: none;
  }
  .blogpost-back:hover { transform: translateX(-4px); color: var(--accent); }

  .blogpost-category {
    display: inline-block; font-family: var(--font-mono);
    font-size: .65rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--gold); font-weight: 400; margin-bottom: .8rem;
    border: 1.3px solid var(--gold); padding: 3px 10px; border-radius: 20px;
  }

  .blogpost-title {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.0;
    letter-spacing: -.035em;
    color: var(--text);
    margin-bottom: 1rem;
    font-weight: 640;
  }

  .blogpost-body { max-width: 680px; }
  .blogpost-body h2 { font-family: var(--font-head); font-size: 1.7rem; letter-spacing: -.025em; line-height: 1.2; color: var(--text); margin: 2.2rem 0 .8rem; font-weight: 640; }
  .blogpost-body h3 { font-family: var(--font-head); font-size: 1.25rem; color: var(--text); margin: 1.6rem 0 .6rem; font-weight: 640; }
  .blogpost-body p  { font-size: .97rem; color: var(--text2); line-height: 1.85; margin-bottom: 1.3rem; }
  .blogpost-body strong { color: var(--text); font-weight: 600; }
  .blogpost-body ul, .blogpost-body ol { padding-left: 1.4rem; margin-bottom: 1.2rem; }
  .blogpost-body li { font-size: .97rem; color: var(--text2); line-height: 1.8; margin-bottom: .3rem; }
  .blogpost-body a  { color: var(--accent); text-underline-offset: 3px; }

  /* ── ABOUT PAGE ─────────────────────────────────── */
  .about-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: 5rem; align-items: start; }
  .about-text h2 {
    font-family: var(--font-head);
    font-size: clamp(1.9rem, 3.5vw, 2.7rem);
    letter-spacing: -.03em;
    line-height: 1.1;
    color: var(--text);
    margin-bottom: 1.3rem;
    font-weight: 640;
  }
  .about-text p { font-size: .94rem; color: var(--text2); line-height: 1.85; margin-bottom: 1rem; }
  .about-text p strong { color: var(--text); font-weight: 600; }
  .about-stack { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 1.8rem; }
  .stack-item { font-family: var(--font-mono); font-size: .72rem; color: var(--text); background: var(--paper-alt); padding: 5px 11px; border-radius: 20px; border: 1.3px solid var(--border-str); letter-spacing: .03em; }

  .cost-list { display: flex; flex-direction: column; gap: 9px; }
  .cost-card {
    background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 10px;
    padding: .9rem 1.2rem; display: flex; align-items: center; justify-content: space-between;
  }
  .cost-name { font-size: .84rem; color: var(--text); font-weight: 600; }
  .cost-val  { font-size: .84rem; font-weight: 600; font-family: var(--font-mono); }
  .cost-val.free { color: var(--accent); }
  .cost-total { background: var(--paper-alt); border-color: var(--accent); }

  /* ── REVEAL ANIMATIONS — only hide when JS is live ── */
  html.js .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s var(--ease-out), transform .65s var(--ease-out); }
  html.js .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: .1s; }
  .reveal-delay-2 { transition-delay: .2s; }
  .reveal-delay-3 { transition-delay: .3s; }
  .reveal-delay-4 { transition-delay: .4s; }

  html.js [data-reveal="left"]  { opacity: 0; transform: translateX(-36px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  html.js [data-reveal="right"] { opacity: 0; transform: translateX(36px);  transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  html.js [data-reveal="up"]    { opacity: 0; transform: translateY(36px);  transition: opacity .7s var(--ease-out), transform .7s var(--ease-out); }
  html.js [data-reveal="scale"] { opacity: 0; transform: scale(0.88);       transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); }
  html.js [data-reveal].in-view { opacity: 1; transform: none; }
  [data-reveal-delay="1"] { transition-delay: .1s; }
  [data-reveal-delay="2"] { transition-delay: .22s; }
  [data-reveal-delay="3"] { transition-delay: .38s; }
  [data-reveal-delay="4"] { transition-delay: .54s; }

  /* ── HERO ENTRANCE (CSS-only) ─── */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero-fade-in {
    animation: heroIn .75s cubic-bezier(.16,1,.3,1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in { animation: none; }
    html.js .reveal, html.js [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ── FOOTER ─────────────────────────────────────── */
  footer { margin-top: 1rem; position: relative; }
  footer::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: min(var(--max), 92%); border-top: 2px solid var(--sketch);
    filter: url(#sk-b); opacity: .55;
  }
  .footer-inner {
    max-width: var(--max); margin: 0 auto;
    padding: 1.6rem 2rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  .footer-left { font-size: .75rem; color: var(--text2); font-family: var(--font-mono); }
  .footer-left strong { color: var(--text); }
  .footer-right { display: flex; gap: 1.4rem; }
  .footer-right a {
    font-family: var(--font-mono);
    font-size: .72rem; color: var(--text3); font-weight: 400;
    text-decoration: none; transition: color .2s; letter-spacing: .04em;
  }
  .footer-right a:hover { color: var(--accent); }

  /* ── ADMIN PANEL ────────────────────────────────── */
  #admin-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.55); backdrop-filter: blur(8px);
  }
  #admin-overlay.open { display: flex; align-items: center; justify-content: center; padding: 1.2rem; }
  #admin-panel {
    width: 100%; max-width: 1000px; height: min(88vh, 760px); margin: auto;
    background: var(--paper); border-radius: 18px;
    overflow: hidden; border: 1px solid var(--border-str);
    box-shadow: 0 40px 100px rgba(0,0,0,.4);
    display: grid; grid-template-columns: 232px minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    animation: adminPop .42s var(--spring) both;
  }
  @keyframes adminPop { from { opacity: 0; transform: translateY(14px) scale(.985); } }

  .admin-side {
    background: var(--paper-alt);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column; min-width: 0; min-height: 0;
    overflow: hidden;
    padding: 1.2rem .9rem;
  }
  .admin-brand {
    display: flex; align-items: center; gap: 9px;
    padding: .2rem .5rem 1rem; margin-bottom: .4rem;
    border-bottom: 1px solid var(--border);
  }
  .admin-brand-mark {
    width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
    background: var(--accent); color: #fff; display: flex;
    align-items: center; justify-content: center; font-size: .9rem;
    box-shadow: 0 4px 12px var(--glow-cool);
  }
  .admin-brand-txt { line-height: 1.1; }
  .admin-brand-txt b { font-family: var(--font-head); font-size: .98rem; color: var(--text); font-weight: 700; display: block; }
  .admin-brand-txt span { font-family: var(--font-mono); font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text3); }

  .admin-nav { display: flex; flex-direction: column; gap: 3px; margin-top: .7rem; overflow-y: auto; flex: 1; }
  .admin-navitem {
    display: flex; align-items: center; gap: 11px;
    padding: .6rem .7rem; border-radius: 9px; cursor: pointer;
    border: 1px solid transparent; background: none; text-align: left; width: 100%;
    transition: background .18s, border-color .18s, transform .18s;
  }
  .admin-navitem:hover { background: var(--tag-bg); }
  .admin-navitem.active { background: var(--tag-bg); border-color: var(--border-str); }
  .admin-navitem.active .admin-navicon { background: var(--accent); color: #fff; border-color: transparent; }
  .admin-navicon {
    width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: .92rem;
    background: var(--paper); border: 1px solid var(--border); color: var(--text);
    transition: background .18s, color .18s;
  }
  .admin-navtext b { display: block; font-family: var(--font-body); font-size: .82rem; font-weight: 600; color: var(--text); line-height: 1.2; }
  .admin-navtext span { font-size: .64rem; color: var(--text3); font-family: var(--font-mono); letter-spacing: .02em; }

  .admin-side-foot { margin-top: .8rem; padding-top: .8rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px; }
  .admin-side-link {
    display: flex; align-items: center; gap: 8px; font-family: var(--font-mono);
    font-size: .68rem; color: var(--text3); text-decoration: none; padding: .4rem .5rem;
    border-radius: 6px; cursor: pointer; background: none; border: none; width: 100%; text-align: left;
    transition: color .18s, background .18s;
  }
  .admin-side-link:hover { color: var(--accent); background: var(--paper); }

  .admin-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--paper); }
  .admin-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;
    padding: 1.3rem 1.6rem 1.1rem; border-bottom: 1px solid var(--border); flex-shrink: 0;
  }
  .admin-head h2 { font-family: var(--font-head); font-size: 1.45rem; color: var(--text); font-weight: 700; letter-spacing: -.02em; line-height: 1.1; }
  .admin-head p { font-size: .8rem; color: var(--text3); margin-top: 3px; max-width: 460px; line-height: 1.5; }
  .admin-close {
    background: var(--paper-alt); border: 1px solid var(--border-str); border-radius: 8px;
    width: 32px; height: 32px; flex-shrink: 0; font-size: .95rem; cursor: pointer; color: var(--text);
    transition: all .2s; display: flex; align-items: center; justify-content: center;
  }
  .admin-close:hover { transform: rotate(90deg); border-color: var(--accent); color: var(--accent); }

  .admin-body { overflow-y: auto; flex: 1; padding: 1.5rem 1.6rem; scroll-behavior: smooth; }
  .admin-section { display: none; animation: adminFade .35s var(--ease-out) both; }
  .admin-section.active { display: block; }
  @keyframes adminFade { from { opacity: 0; transform: translateY(8px); } }
  .admin-label {
    font-family: var(--font-mono); font-size: .65rem;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--text); font-weight: 400;
    margin-bottom: .4rem; margin-top: 1.2rem;
  }
  .admin-label:first-child { margin-top: 0; }
  .admin-input, .admin-textarea, .admin-select {
    width: 100%; background: var(--card-bg);
    border: 1px solid var(--border-str); border-radius: 7px;
    padding: .6rem .9rem; font-family: var(--font-body);
    font-size: .87rem; color: var(--text);
    transition: border-color .2s; outline: none;
  }
  .admin-input:focus, .admin-textarea:focus, .admin-select:focus { border-color: var(--accent); }
  .admin-textarea { min-height: 100px; resize: vertical; line-height: 1.6; }
  .admin-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .admin-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: .55rem 1.2rem; background: var(--accent); color: #fff;
    border: 1.5px solid transparent; border-radius: 7px;
    font-family: var(--font-body); font-size: .82rem; font-weight: 600;
    cursor: pointer; transition: transform .2s, box-shadow .2s;
    box-shadow: 0 2px 8px var(--glow-cool);
  }
  [data-theme="dark"] .admin-btn { color: var(--ink); }
  .admin-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px var(--glow-cool); }
  .admin-btn.secondary { background: var(--paper-alt); color: var(--text); box-shadow: none; border-color: var(--border-str); }
  .admin-divider { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }
  .admin-card-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.2rem; }
  .admin-item {
    background: var(--card-bg); border: 1px solid var(--border-str);
    border-radius: 8px; padding: .8rem 1rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .admin-item-info { flex: 1; min-width: 0; }
  .admin-item-title { font-size: .85rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .admin-item-sub { font-size: .72rem; color: var(--text3); margin-top: 2px; }
  .admin-item-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .admin-icon-btn {
    background: var(--paper-alt); border: 1px solid var(--border-str); border-radius: 5px;
    padding: 4px 8px; cursor: pointer; font-size: .75rem; color: var(--text);
    transition: all .2s; font-family: var(--font-mono);
  }
  .admin-icon-btn:hover { transform: translateY(-1px); border-color: var(--accent); }
  .admin-icon-btn.del:hover { color: #c0392b; border-color: #c0392b; }
  .admin-notice {
    background: var(--paper-alt); border: 1px solid var(--border-str);
    border-radius: 7px; padding: .7rem 1rem;
    font-size: .82rem; color: var(--text); margin-bottom: 1.2rem;
  }
  .admin-save-bar {
    padding: .9rem 1.6rem; border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    flex-shrink: 0; background: var(--paper-alt);
  }
  .admin-dirty {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: .68rem; color: var(--text3);
    transition: color .2s;
  }
  .admin-dirty .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text3); transition: background .2s; }
  .admin-dirty.unsaved { color: var(--gold); }
  .admin-dirty.unsaved .dot { background: var(--gold); animation: pulse 2s infinite; }
  .admin-dirty.saved { color: #2f9e44; }
  .admin-dirty.saved .dot { background: #2f9e44; animation: none; }
  .admin-save-actions { display: flex; gap: 10px; }

  /* ── TOASTS ── */
  #admin-toasts {
    position: fixed; top: 1rem; left: 50%; transform: translateX(-50%);
    z-index: 400; display: flex; flex-direction: column; gap: 8px;
    pointer-events: none; width: max-content; max-width: calc(100vw - 2rem);
  }
  .admin-toast {
    display: flex; align-items: center; gap: 10px;
    background: var(--ink); color: #F2EFE6;
    border-radius: 10px; padding: .7rem 1.1rem; font-size: .82rem; font-weight: 500;
    box-shadow: 0 14px 40px rgba(0,0,0,.32); pointer-events: auto;
    animation: toastIn .4s var(--spring) both; border: 1px solid rgba(255,255,255,.08);
  }
  .admin-toast .ti { font-size: .95rem; line-height: 1; }
  .admin-toast.ok    { border-left: 3px solid #4ade80; }
  .admin-toast.warn  { border-left: 3px solid var(--gold); }
  .admin-toast.err   { border-left: 3px solid #f87171; }
  .admin-toast.act   { cursor: pointer; }
  .admin-toast.out   { animation: toastOut .35s var(--ease-out) forwards; }
  @keyframes toastIn  { from { opacity: 0; transform: translateY(-14px) scale(.95); } }
  @keyframes toastOut { to   { opacity: 0; transform: translateY(-10px) scale(.97); } }
  .admin-toast-btn {
    margin-left: 4px; background: rgba(255,255,255,.14); color: #fff; border: none;
    border-radius: 6px; padding: 3px 10px; font-size: .72rem; font-weight: 600; cursor: pointer;
    font-family: var(--font-body);
  }
  .admin-toast-btn:hover { background: rgba(255,255,255,.26); }

  .admin-inline {
    background: var(--paper-alt); border: 1px solid var(--border-str);
    border-radius: 10px; padding: .9rem; margin-bottom: 1rem;
    display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: end;
    animation: adminFade .3s var(--ease-out) both;
  }
  .admin-inline .full { grid-column: 1 / -1; }
  .admin-inline .admin-label { margin-top: 0; }
  .admin-inline-actions { display: flex; gap: 6px; }

  .admin-empty {
    text-align: center; padding: 1.6rem 1rem; border: 1.5px dashed var(--border);
    border-radius: 10px; color: var(--text3); font-size: .8rem; line-height: 1.5;
    margin-bottom: 1rem; background: var(--card-bg);
  }
  .admin-empty .em { font-size: 1.6rem; display: block; margin-bottom: .4rem; opacity: .8; }

  .admin-hint {
    display: flex; gap: 10px; align-items: flex-start;
    background: linear-gradient(135deg, var(--gold-light), transparent);
    border: 1px solid var(--border); border-left: 3px solid var(--gold);
    border-radius: 9px; padding: .75rem .9rem; margin-bottom: 1.3rem;
    font-size: .78rem; color: var(--text2); line-height: 1.55;
  }
  .admin-hint .hi { font-size: 1rem; line-height: 1.2; flex-shrink: 0; }

  .admin-count {
    margin-left: auto; font-family: var(--font-mono); font-size: .6rem;
    background: var(--paper); border: 1px solid var(--border);
    color: var(--text3); border-radius: 20px; padding: 1px 7px; min-width: 18px; text-align: center;
  }
  .admin-navitem.active .admin-count { background: var(--card-bg); color: var(--accent); border-color: var(--border-str); }

  @media (max-width: 720px) {
    #admin-overlay.open { align-items: flex-end; }
    #admin-panel {
      grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr);
      height: 94vh; max-height: 94vh;
      border-radius: 18px 18px 0 0; margin: auto auto 0;
    }
    .admin-side {
      flex-direction: row; align-items: center; gap: 6px;
      border-right: none; border-bottom: 1px solid var(--border);
      padding: .6rem .7rem; overflow-x: auto; overflow-y: hidden;
    }
    .admin-brand, .admin-side-foot { display: none; }
    .admin-nav { flex-direction: row; gap: 6px; margin-top: 0; overflow-x: auto; flex: 1; justify-content: flex-start; }
    .admin-navitem { width: auto; flex-direction: column; gap: 3px; padding: .45rem .6rem; min-width: 64px; flex-shrink: 0; text-align: center; }
    .admin-navicon { margin: 0 auto; }
    .admin-navtext b { font-size: .64rem; }
    .admin-navtext span, .admin-count { display: none; }
    .admin-head h2 { font-size: 1.2rem; }
    .admin-head p { display: none; }
    .admin-inline { grid-template-columns: 1fr; }
    #admin-toasts { width: calc(100vw - 2rem); }
  }
  .admin-color-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: .5rem; }
  .color-opt {
    width: 30px; height: 30px; border-radius: 5px; cursor: pointer;
    border: 1.5px solid var(--border-str); transition: transform .2s var(--spring), box-shadow .2s;
  }
  .color-opt:hover, .color-opt.selected {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .admin-select { cursor: pointer; }

  #admin-trigger {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 150;
    width: 48px; height: 48px; border-radius: 10px;
    background: var(--card-bg); color: var(--text);
    border: 1px solid var(--border-str);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem;
    box-shadow: 0 4px 14px rgba(0,0,0,.12);
    transition: transform .2s var(--spring), box-shadow .2s;
    backdrop-filter: blur(8px);
  }
  #admin-trigger:hover { transform: translateY(-3px) rotate(20deg); box-shadow: 0 8px 24px rgba(0,0,0,.18); }

  #admin-login {
    position: fixed; inset: 0; z-index: 300;
    background: rgba(0,0,0,.6); backdrop-filter: blur(10px);
    display: none; align-items: center; justify-content: center;
  }
  #admin-login.open { display: flex; }
  .login-box {
    background: var(--paper); border: 1px solid var(--border-str);
    border-radius: 16px; padding: 2.5rem 2rem; width: 340px;
    text-align: center; box-shadow: 0 32px 80px rgba(0,0,0,.3);
  }
  .login-box h3 { font-family: var(--font-head); font-size: 1.6rem; color: var(--text); margin-bottom: .6rem; font-weight: 700; }
  .login-box p { font-size: .86rem; color: var(--text2); margin-bottom: 1.5rem; line-height: 1.6; }
  .login-error { font-family: var(--font-mono); font-size: .75rem; color: #c0392b; margin-top: .5rem; display: none; }

  /* ── PAGE HEADERS ── */
  .page-header { padding: 3.5rem 2rem 0; max-width: 1100px; margin: 0 auto; }
  .page-header h1 { font-family: var(--font-head); font-size: clamp(2.2rem,5vw,3.6rem); letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 0.8rem; font-weight: 640; }
  .page-header p { font-size: 1rem; color: var(--text2); font-weight: 400; max-width: 500px; line-height: 1.7; }

  /* ── RESPONSIVE ─────────────────────────────────── */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 3rem; min-height: auto; padding: 3.5rem 1.5rem 2.5rem; }
    .hero-bmark { display: none; }
    .featured-inner { grid-template-columns: 1fr; }
    .featured-visual { min-height: 180px; border-left: none; border-top: 1px solid var(--border); }
    .about-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .home-two-col { grid-template-columns: 1fr !important; }
    .admin-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .section { padding: 2.5rem 1.2rem; }
    .hero { padding: 3rem 1.2rem 2rem; }
    .hero-stats { gap: 1.2rem; }
    .hero h1 { font-size: clamp(2.4rem, 9vw, 3.2rem); }
    .hero h1 em { white-space: normal; }
    .hero-sub { font-size: 0.95rem; }
    .hero-eyebrow { font-size: .62rem; letter-spacing: .08em; }
    #admin-panel { max-height: 95vh; border-radius: 12px 12px 0 0; margin: auto auto 0; }
    .footer-inner { flex-direction: column; gap: .75rem; text-align: center; }
    .footer-right { justify-content: center; }
    .page-header { padding: 2.5rem 1.2rem 0; }
    .page-header h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
  }

  @media (orientation: landscape) and (max-height: 540px) {
    .hero { padding: 2rem 1.5rem 1.5rem; gap: 2rem; grid-template-columns: 1fr 1fr; min-height: auto; }
    :root { --nav-h: 52px; }
    .hero h1 { font-size: clamp(2rem, 5vw, 3rem); }
  }

  @supports (padding: max(0px)) {
    nav { padding-left: max(0px, env(safe-area-inset-left)); padding-right: max(0px, env(safe-area-inset-right)); }
    body { padding-bottom: env(safe-area-inset-bottom); }
  }

  /* ── HAMBURGER BUTTON ────────────────────────────── */
  .nav-mobile-controls {
    display: none;
    align-items: center;
    gap: 6px;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: var(--paper-alt);
    border: 1px solid var(--border-str);
    border-radius: 8px;
    cursor: pointer;
    transition: background .2s, border-color .2s;
    flex-shrink: 0;
  }
  .hamburger:hover { background: var(--tag-bg); border-color: var(--accent); }

  .ham-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transform-origin: center;
    transition: transform .35s var(--spring), opacity .25s, width .3s;
  }
  .hamburger.open .ham-line:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.open .ham-line:nth-child(2) { transform: scaleX(0); opacity: 0; }
  .hamburger.open .ham-line:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── MOBILE FULL-SCREEN MENU ─────────────────────── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--paper);
    transform: translateX(100%);
    transition: transform .44s cubic-bezier(.16,1,.3,1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-menu.open { transform: translateX(0); }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.4rem;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    position: sticky;
    top: 0;
    background: var(--paper);
    z-index: 1;
  }

  .mobile-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-alt);
    border: 1px solid var(--border-str);
    border-radius: 8px;
    cursor: pointer;
    color: var(--text);
    transition: background .2s, color .2s, border-color .2s;
    flex-shrink: 0;
  }
  .mobile-close:hover { background: var(--tag-bg); color: var(--accent); border-color: var(--accent); }

  .mobile-nav-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0;
    list-style: none;
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1rem 1.4rem;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateX(24px);
    transition: opacity .35s var(--ease-out), transform .35s var(--ease-out), background .2s;
  }
  .mobile-menu.open .mobile-nav-item { opacity: 1; transform: translateX(0); }
  .mobile-menu.open .mobile-nav-item:nth-child(1) { transition-delay: .06s; }
  .mobile-menu.open .mobile-nav-item:nth-child(2) { transition-delay: .11s; }
  .mobile-menu.open .mobile-nav-item:nth-child(3) { transition-delay: .16s; }
  .mobile-menu.open .mobile-nav-item:nth-child(4) { transition-delay: .21s; }
  .mobile-menu.open .mobile-nav-item:nth-child(5) { transition-delay: .26s; }

  .mobile-nav-item:hover { background: var(--paper-alt); }
  .mobile-nav-item:active { background: var(--tag-bg); }
  .mobile-nav-item.active { color: var(--accent); }
  .mobile-nav-item.active .mobile-nav-label { color: var(--accent); }

  .mobile-nav-num {
    font-family: var(--font-mono);
    font-size: .6rem;
    color: var(--text3);
    letter-spacing: .1em;
    width: 24px;
    flex-shrink: 0;
  }
  .mobile-nav-label {
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 640;
    letter-spacing: -.04em;
    line-height: 1;
    flex: 1;
    color: var(--text);
  }
  .mobile-nav-arrow {
    font-size: .9rem;
    color: var(--text3);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity .2s, transform .2s;
    flex-shrink: 0;
  }
  .mobile-nav-item:hover .mobile-nav-arrow,
  .mobile-nav-item.active .mobile-nav-arrow {
    opacity: 1;
    transform: none;
    color: var(--gold);
  }

  .mobile-menu-footer {
    padding: 1.4rem;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .mobile-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mobile-toggle-label {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--text2);
    text-transform: uppercase;
    letter-spacing: .1em;
  }
  .mobile-social-row {
    display: flex;
    gap: 1.2rem;
  }
  .mobile-social-row a {
    font-family: var(--font-mono);
    font-size: .72rem;
    color: var(--text3);
    text-decoration: none;
    letter-spacing: .04em;
    transition: color .2s;
    padding: .5rem 0;
  }
  .mobile-social-row a:hover { color: var(--accent); }

  @media (max-width: 840px) {
    .nav-links { display: none !important; }
    .toggle-wrap { display: none !important; }
    .nav-mobile-controls { display: flex; }
  }

  body.menu-open { overflow: hidden; }

  /* ── HIDDEN EASTER-EGG OVERLAYS ──────────────────── */
  /* Full-screen dark overlays; theme-agnostic by design. Triggered from
     bharcode-enhancements.js (Konami · logo ×5 · type "bharcode"). */
  .bc-overlay {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: rgba(0,0,0,.85); backdrop-filter: blur(6px);
    align-items: center; justify-content: center;
  }
  .bc-overlay.open { display: flex; }

  /* ── SPACE INVADERS OVERLAY ──────────────────────── */
  #game-overlay { flex-direction: column; gap: 10px; }
  #game-canvas  { border-radius: 12px; border: 1px solid rgba(255,255,255,.1); box-shadow: 0 0 60px rgba(96,165,250,.18); display: block; }
  #game-hint    { font-family: var(--font-mono); font-size: .68rem; color: rgba(255,255,255,.35); letter-spacing: .08em; text-align: center; }
  #game-close   { font-family: var(--font-mono); font-size: .7rem; color: rgba(255,255,255,.35); background: none; border: 1px solid rgba(255,255,255,.15); border-radius: 6px; padding: 4px 16px; cursor: pointer; transition: all .2s; letter-spacing: .06em; }
  #game-close:hover { color: #fff; border-color: rgba(255,255,255,.5); }

  /* ── MATRIX OVERLAY ──────────────────────────────── */
  #matrix-overlay { cursor: pointer; }
  #matrix-canvas  { position: absolute; inset: 0; }
  #matrix-overlay::after { content: 'CLICK OR WAIT TO EXIT'; position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: .62rem; color: rgba(0,255,65,.35); letter-spacing: .2em; pointer-events: none; }

  /* ── TERMINAL OVERLAY ────────────────────────────── */
  #terminal-overlay { align-items: flex-end; justify-content: flex-end; padding: 1.5rem; background: transparent; backdrop-filter: none; pointer-events: none; }
  #terminal-overlay.open { pointer-events: all; }
  #terminal-box { width: 400px; max-width: calc(100vw - 2rem); background: #0d1117; border: 1px solid rgba(74,222,128,.25); border-radius: 12px; overflow: hidden; box-shadow: 0 0 40px rgba(74,222,128,.12), 0 24px 60px rgba(0,0,0,.7); font-family: var(--font-mono); }
  #terminal-bar { background: #161b22; padding: 8px 14px; display: flex; align-items: center; gap: 7px; border-bottom: 1px solid rgba(74,222,128,.1); }
  .term-dot { width: 10px; height: 10px; border-radius: 50%; }
  #terminal-title { color: rgba(255,255,255,.35); font-size: .68rem; letter-spacing: .08em; margin-left: auto; }
  #terminal-output { padding: 12px 14px; height: 200px; overflow-y: auto; color: #e2e8f0; line-height: 1.75; font-size: .76rem; scrollbar-width: thin; scrollbar-color: rgba(74,222,128,.2) transparent; }
  #terminal-input-row { display: flex; align-items: center; gap: 8px; padding: 7px 14px; border-top: 1px solid rgba(74,222,128,.1); }
  #terminal-prompt { color: #4ade80; font-size: .76rem; flex-shrink: 0; }
  #terminal-input { flex: 1; background: none; border: none; outline: none; color: #f1f5f9; font-family: var(--font-mono); font-size: .76rem; caret-color: #4ade80; }
</style>
</head>
<body>

<!-- Hand-drawn line filters: two turbulence passes per stroke = pencil wobble.
     Referenced by the .sk-box / .btn / card borders across the site. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <filter id="sk-a" x="-6%" y="-6%" width="112%" height="112%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012 0.024" numOctaves="2" seed="7" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="5.5"/>
    </filter>
    <filter id="sk-b" x="-6%" y="-6%" width="112%" height="112%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02 0.032" numOctaves="2" seed="13" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
    </filter>
    <filter id="sk-c" x="-8%" y="-8%" width="116%" height="116%">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.016" numOctaves="2" seed="3" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="7"/>
    </filter>
  </defs>
</svg>

<div class="bg-field" aria-hidden="true">
  <span class="au1"></span><span class="au2"></span><span class="au3"></span><span class="au4"></span>
</div>

<!-- ░░ HIDDEN GAME: Space Invaders (Konami code) ░░ -->
<div id="game-overlay" class="bc-overlay">
  <canvas id="game-canvas"></canvas>
  <div id="game-hint"></div>
  <button id="game-close" onclick="document.getElementById('game-overlay').classList.remove('open')">ESC / close</button>
</div>

<!-- ░░ HIDDEN: Matrix rain (click logo ×5) ░░ -->
<div id="matrix-overlay" class="bc-overlay">
  <canvas id="matrix-canvas"></canvas>
</div>

<!-- ░░ HIDDEN: Terminal easter egg (type "bharcode") ░░ -->
<div id="terminal-overlay" class="bc-overlay">
  <div id="terminal-box">
    <div id="terminal-bar">
      <div class="term-dot" style="background:#ff5f57"></div>
      <div class="term-dot" style="background:#ffbd2e"></div>
      <div class="term-dot" style="background:#28ca41"></div>
      <span id="terminal-title">bharcode — terminal</span>
    </div>
    <div id="terminal-output"></div>
    <div id="terminal-input-row">
      <span id="terminal-prompt">$</span>
      <input id="terminal-input" type="text" autocomplete="off" spellcheck="false" placeholder="type a command…">
    </div>
  </div>
</div>

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <span class="logo-icon" aria-hidden="true">
        <picture>
          <source srcset="/assets/logo.webp" type="image/webp">
          <img
            src="/assets/logo.png"
            alt=""
            width="30"
            height="30"
            onerror="this.closest('.logo-icon').style.display='none'"
          >
        </picture>
      </span>
      <span><span class="logo-accent">Bhar</span>code</span>
    </a>
    <ul class="nav-links">
      <li><a href="/" class:list={[{ active: Astro.url.pathname === '/' }]}>Home</a></li>
      <li><a href="/work" class:list={[{ active: Astro.url.pathname === '/work' }]}>Work</a></li>
      <li><a href="/blog" class:list={[{ active: Astro.url.pathname.startsWith('/blog') }]}>Blog</a></li>
      <li><a href="/apps" class:list={[{ active: Astro.url.pathname === '/apps' }]}>Apps</a></li>
      <li><a href="/about" class:list={[{ active: Astro.url.pathname === '/about' }]}>About</a></li>
    </ul>
    <div class="toggle-wrap">
      <span class="toggle-label" id="theme-label">Light</span>
      <label class="toggle" aria-label="Toggle dark mode">
        <input type="checkbox" id="theme-toggle">
        <div class="toggle-track"></div>
        <div class="toggle-thumb"></div>
      </label>
    </div>

    <!-- Mobile: hamburger only, theme toggle lives inside mobile menu -->
    <div class="nav-mobile-controls">
      <button class="hamburger" id="hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="ham-line"></span>
        <span class="ham-line"></span>
        <span class="ham-line"></span>
      </button>
    </div>
