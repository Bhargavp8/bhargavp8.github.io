<AdminPanel />

<script is:inline>
  // ── CUSTOM CURSOR ──────────────────────────────────────────────
  const cursorEl = document.getElementById('cursor-plus');

  document.addEventListener('mousemove', e => {
    cursorEl.style.left = e.clientX + 'px';
    cursorEl.style.top  = e.clientY + 'px';
    cursorEl.classList.add('show');
    const isClickable = e.target.closest('a, button, .toggle, input, .pin-card, .featured-card, .blog-card, .project-card');
    if (isClickable) {
      cursorEl.classList.add('hovering');
      cursorEl.innerText = '○';
    } else {
      cursorEl.classList.remove('hovering');
      cursorEl.innerText = '+';
    }
  });
  document.addEventListener('mouseleave', () => cursorEl.classList.remove('show'));

  // ── THEME TOGGLE ───────────────────────────────────────────────
  const toggle = document.getElementById('theme-toggle');
  const label  = document.getElementById('theme-label');
  const html   = document.documentElement;

  function applyTheme(theme) {
    html.setAttribute('data-theme', theme);
    if (toggle) toggle.checked = (theme === 'dark');
    if (label)  label.textContent = theme === 'dark' ? 'Dark' : 'Light';
  }

  // Sync toggle state with whatever the inline script set at parse time
  const currentTheme = html.getAttribute('data-theme') || 'light';
  applyTheme(currentTheme);

  toggle && toggle.addEventListener('change', () => {
    const t = toggle.checked ? 'dark' : 'light';
    applyTheme(t);
    localStorage.setItem('bharcode-theme', t);
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
    if (!localStorage.getItem('bharcode-theme')) applyTheme(e.matches ? 'dark' : 'light');
  });

  // ── SCROLL REVEAL ──────────────────────────────────────────────
  function initReveal() {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal);
  } else {
    initReveal();
  }
</script>

<!-- The Master Script Engine (Glitch, Ticker, Nav, Tilt, Admin UX) -->
<script src="/bharcode-enhancements.js" defer></script>
