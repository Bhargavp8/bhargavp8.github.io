---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../../public/data.json';
const { general, hero, blogPosts, appCards, appsFeature } = data;

// Determine which app to show in the homepage bot widget
const selection = general?.featuredAppSelection || 'featured';
let featuredApp: any;
if (selection === 'featured') {
  featuredApp = appsFeature;
} else if (selection.startsWith('app-')) {
  const index = parseInt(selection.replace('app-', ''), 10);
  featuredApp = appCards?.[index] ?? appsFeature;
} else {
  featuredApp = appsFeature;
}

// Only show posts that have real body content
const livePosts = (blogPosts || [])
  .filter((p: any) => p.title && p.excerpt && p.body?.trim().length > 10)
  .slice(0, 3);
---
<BaseLayout title="Bharcode — Building Passive Income From Code">

  <!-- HERO -->
  <div class="hero hero-cinematic" style="position:relative;overflow:hidden;">
    <!-- Hand-built 3D lattice: spins on its own, follows the mouse, drag to throw, tilt to gyro -->
    <div class="hero-orbit" aria-hidden="true"></div>
    <canvas id="hero-lattice" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;z-index:0;opacity:0.95;"></canvas>
    <div class="scroll-cue" aria-hidden="true">Scroll<div class="bar"></div></div>

    <div style="position:relative;z-index:1;" data-tour="hero" data-depth="14">
      <div class="hero-eyebrow hero-fade-in" style="--d:0s">
        <div class="hero-dot"></div>
        <span data-scramble>{hero?.eyebrow || 'Singapore · CS Student · Building in Public'}</span>
      </div>
      <h1 class="hero-fade-in" style="--d:.1s">
        {hero?.headline || 'Code that builds'}<br>
        <em>{hero?.headlineEm || 'passive income.'}</em>
      </h1>
      <p class="hero-sub hero-fade-in" style="--d:.22s">
        {hero?.sub || "Zero overhead. Real results. I document how I'm building affiliate income, bots, and automation tools — for the cost of a domain name."}
      </p>
      <div class="hero-actions hero-fade-in" style="--d:.36s">
        <a href="/work" class="btn-primary">{hero?.ctaPrimary || 'See My Work'}</a>
        <a href="/blog" class="btn-outline">{hero?.ctaSecondary || 'Read the Blog'}</a>
        <button id="gyro-btn" class="gyro-btn" type="button" aria-label="Enable tilt interaction">
          <span class="gyro-ico" aria-hidden="true"></span>
          <span class="gyro-label">Tilt to explore</span>
        </button>
      </div>
      <div class="hero-stats hero-fade-in" style="--d:.5s" data-tour="stats">
        <div>
          <div class="stat-num">{general?.stat1Num || '$10'}</div>
          <div class="stat-label">{general?.stat1Label || 'Annual cost'}</div>
        </div>
        <div>
          <div class="stat-num">{general?.stat2Num || '5+'}</div>
          <div class="stat-label">{general?.stat2Label || 'Projects live'}</div>
        </div>
        <div>
          <div class="stat-num">{general?.stat3Num || 'Day 1'}</div>
          <div class="stat-label">{general?.stat3Label || 'Building in public'}</div>
        </div>
      </div>
    </div>

    <!-- PIN STACK — 3 most recent live posts -->
    <div data-depth="30">
      <div class="pin-preview-stack">
        {livePosts.length === 0 ? (
          <div style="font-size:0.8rem;color:var(--text3);border:1.5px dashed var(--border);padding:2rem;border-radius:8px;text-align:center;grid-column:span 2;">
            No published posts yet.<br/>Create your first blog post.
          </div>
        ) : livePosts.map((post: any, i: number) => {
          // If an odd number of posts, make the last one span the full row
          const isWide = livePosts.length % 2 !== 0 && i === livePosts.length - 1;
          return isWide ? (
            <a href={`/blog/${post.id}`} class={`pin-card wide reveal reveal-delay-${Math.min(i + 1, 4)}`}>
              <div class={`pin-thumb ${post.color || 'th-green'}`}>{post.emoji || '📝'}</div>
              <div class="pin-info">
                <div class="pin-title">{post.title}</div>
                <div class="pin-meta">bharcode.com · Latest post</div>
              </div>
            </a>
          ) : (
            <a href={`/blog/${post.id}`} class={`pin-card reveal reveal-delay-${Math.min(i + 1, 4)}`}>
              <div class={`pin-thumb ${post.color || 'th-green'}`}>{post.emoji || '📝'}</div>
              <div class="pin-info">
                <div class="pin-title">{post.title}</div>
                <div class="pin-meta">bharcode.com</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- SELECTED WORK STRIP -->
  <div class="work-strip-wrap">
    <div class="work-strip" data-tour="work">
      <div class="work-strip-label">Selected Work</div>
      <div class="work-strip-cards">

        <a href="/work" class="work-strip-card reveal">
          <div class="wsc-top">
            <div class="wsc-status status-live"><div class="status-dot"></div>Live</div>
            <span class="wsc-num">#01</span>
          </div>
          <div class="wsc-title">Knot</div>
          <p class="wsc-desc">Full-stack group expense app. Next.js 15, Supabase, Google OAuth, Gemini NLP parsing, Telegram bot companion.</p>
          <div class="wsc-stack">
            {['Next.js', 'Supabase', 'TypeScript', 'AI'].map((t: string) => <span class="tag">{t}</span>)}
          </div>
          <div class="wsc-arrow">↗</div>
        </a>

        <a href="/work#sliqe" class="work-strip-card reveal reveal-delay-1">
          <div class="wsc-top">
            <div class="wsc-status status-building"><div class="status-dot"></div>Building</div>
            <span class="wsc-num">#02</span>
          </div>
          <div class="wsc-title">Sliqe</div>
          <p class="wsc-desc">Two-sided food-waste marketplace. Time-decay pricing drives impulse conversions. Vendor onboarding under 30 seconds.</p>
          <div class="wsc-stack">
            {['Product Design', 'UI/UX', 'Marketplace'].map((t: string) => <span class="tag">{t}</span>)}
          </div>
          <div class="wsc-arrow">↗</div>
        </a>

        <a href="/" class="work-strip-card work-strip-card--next reveal reveal-delay-2">
          <div style="font-size:1.6rem;margin-bottom:0.8rem;">🔧</div>
          <div class="wsc-title" style="font-size:1rem;">Next project</div>
          <p class="wsc-desc">Taking shape. Subscribe for early access and build-along posts.</p>
          <span class="featured-link" style="margin-top:auto;">Follow the build →</span>
        </a>

      </div>
    </div>
  </div>

  <!-- EMAIL CAPTURE -->
  <div style="border-top:1.5px solid var(--border);border-bottom:1.5px solid var(--border);background:var(--bg-alt);" data-tour="newsletter">
    <div class="newsletter-inner">
      <div>
        <div class="section-label">Free Newsletter</div>
        <h2 style="font-family:var(--font-head);font-size:clamp(1.4rem,3vw,2rem);letter-spacing:-0.02em;color:var(--text);margin-bottom:0.4rem;">
          Building in public, weekly.
        </h2>
        <p style="font-size:0.88rem;color:var(--text2);max-width:380px;line-height:1.7;">
          No fluff. Real numbers, real mistakes, real progress — straight to your inbox. Free forever.
        </p>
      </div>
      <div style="background:var(--card-bg);border:1.5px solid var(--border);border-radius:12px;overflow:hidden;">
        <iframe
          src="https://bharcode08.substack.com/embed"
          width="100%"
          height="150"
          style="display:block;border:none;background:transparent;"
          frameborder="0"
          scrolling="no"
          title="Newsletter signup"
        ></iframe>
      </div>
    </div>
  </div>

  <!-- FEATURED CARDS -->
  <div class="section" style="padding-top:3rem;padding-bottom:2.5rem;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;" class="home-two-col">

      <!-- Card 1 — Blog -->
      <a href="/blog" class="featured-card" data-reveal="left" style="text-decoration:none;">
        <div class="featured-inner">
          <div class="featured-content">
            <div>
              <div class="card-status status-live"><div class="status-dot"></div>Live</div>
              <div class="card-title" style="font-family:var(--font-head);font-size:1.55rem;line-height:1.1;margin-bottom:0.6rem;">
                {general?.feat1Title || 'Affiliate Blog'}
              </div>
              <p class="card-desc" style="font-size:0.87rem;">
                {general?.feat1Desc || 'Strategy posts on passive income, tools, and making money online.'}
              </p>
            </div>
            <span class="featured-link">{general?.feat1Link || 'Read latest posts →'}</span>
          </div>
          <div class="featured-visual">
            <div class="vis-log" aria-hidden="true">
              <div class="vis-log-bar">
                <span class="vlb-dot r"></span><span class="vlb-dot y"></span><span class="vlb-dot g"></span>
                <span class="vlb-name">{general?.feat1Emoji} build.log</span>
              </div>
              <div class="vis-log-body">
                <div class="vis-log-line"><span class="vll-t">now</span><span class="vll-ok">✓</span> shipping in public</div>
                <div class="vis-log-line"><span class="vll-t">dec</span><span class="vll-add">+</span> architecture notes</div>
                <div class="vis-log-line"><span class="vll-t">fix</span><span class="vll-warn">~</span> what broke &amp; why</div>
                <div class="vis-log-line vll-cmd"><span class="vll-prompt">$</span> tail&nbsp;-f<span class="vll-caret"></span></div>
              </div>
            </div>
          </div>
        </div>
      </a>

      <!-- Card 2 — Apps / Bot preview -->
      <a href="/apps" class="featured-card" data-reveal="right" style="text-decoration:none;">
        <div class="featured-inner">
          <div class="featured-content">
            <div>
              <!-- FIX: status badge now reflects the actual featuredApp status -->
              <div class={`card-status ${featuredApp?.status === 'live' ? 'status-live' : featuredApp?.status === 'building' ? 'status-building' : 'status-soon'}`}>
                <div class="status-dot"></div>
                {featuredApp?.status === 'live' ? 'Live' : featuredApp?.status === 'building' ? 'Building' : 'Coming Soon'}
              </div>
              <div class="card-title" style="font-family:var(--font-head);font-size:1.55rem;line-height:1.1;margin-bottom:0.6rem;">
                {general?.feat2Title || 'Income Bots'}
              </div>
              <p class="card-desc" style="font-size:0.87rem;">
                {general?.feat2Desc || 'Telegram bots and automation tools that track earnings, schedule pins, and generate content.'}
              </p>
            </div>
            <span class="featured-link">{general?.feat2Link || 'See all apps →'}</span>
          </div>
          <div class="featured-visual">
            <div class="vis-bot">
              <div class="vis-bot-bar">
                🤖 {featuredApp?.title || 'Income Bot'}
                <span style="margin-left:auto;opacity:0.5;font-size:0.6rem;">
                  ● {featuredApp?.status === 'live' ? 'Live' : featuredApp?.status === 'building' ? 'Building' : 'Soon'}
                </span>
              </div>
              <div class="vis-bot-body">
                <div class="vis-msg bot">📊 {featuredApp?.title?.split(' ')[0] || 'Bot'} update</div>
                <div class="vis-msg user">Show {featuredApp?.title?.split(' ')[0]?.toLowerCase() || 'stats'}</div>
                <!-- FIX: use a safe excerpt instead of full desc to keep the widget compact -->
                <div class="vis-msg bot">{featuredApp?.desc ? featuredApp.desc.slice(0, 80) + '…' : '💰 Total: $51.60'}</div>
              </div>
            </div>
          </div>
        </div>
      </a>

    </div>
  </div>

</BaseLayout>

<style>
  /* ── WORK STRIP ───────────────────────────────────── */
  .work-strip-wrap {
    border-top: 1.5px solid var(--border);
    border-bottom: 1.5px solid var(--border);
    background: var(--bg-alt);
  }
  .work-strip {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }
  .work-strip-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 1.4rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .work-strip-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 1px;
    background: var(--accent);
  }
  .work-strip-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .work-strip-card {
    background: var(--card-bg);
    border: 1px solid var(--border-str);
    box-shadow: 2px 2px 0 var(--gold-light);
    border-radius: 14px;
    padding: 1.4rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    transition: transform 0.25s var(--spring), box-shadow 0.25s;
    min-height: 200px;
  }
  .work-strip-card:hover {
    transform: translate(-3px,-3px);
    box-shadow: 7px 7px 0 var(--accent);
  }
  .work-strip-card--next {
    border-style: dashed;
    box-shadow: none;
    background: var(--paper-alt);
    align-items: flex-start;
    justify-content: flex-start;
  }
  .work-strip-card--next:hover { box-shadow: 5px 5px 0 var(--accent); }
  .wsc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.3rem;
  }
  .wsc-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid transparent;
  }
  .wsc-num {
    font-family: var(--font-head);
    font-size: 0.75rem;
    color: var(--text3);
    font-weight: 700;
    font-style: italic;
  }
  .wsc-title {
    font-family: var(--font-head);
    font-size: 1.2rem;
    color: var(--text);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .wsc-desc {
    font-size: 0.8rem;
    color: var(--text2);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .wsc-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.4rem;
  }
  .wsc-arrow {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    font-size: 0.85rem;
    color: var(--text3);
    transition: transform 0.25s var(--spring), color 0.25s;
  }
  .work-strip-card:hover .wsc-arrow { transform: translate(3px,-3px); color: var(--accent); }

  @media (max-width: 700px) {
    .work-strip-cards { grid-template-columns: 1fr; }
    .work-strip { padding: 2rem 1.2rem; }
    .work-strip-card { min-height: 170px; }
  }

  /* ── NEWSLETTER SECTION ─────────────────────────────────── */
  .newsletter-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 700px) {
    .newsletter-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2.5rem 1.2rem;
    }
  }
</style>